# Copiar este archivo a ".env" y ajustar los valores.
# La app NUNCA debe tener credenciales hardcodeadas: todo sale de estas variables.

# --- Base de datos ---
# Si se define DATABASE_URL, tiene prioridad sobre las variables sueltas de abajo.
# DATABASE_URL=postgresql://turnos_user:turnos_pass@localhost:5432/gestion_turnos
PGHOST=localhost
PGPORT=5432
PGDATABASE=gestion_turnos
PGUSER=turnos_user
PGPASSWORD=turnos_pass

# --- Servidor ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Autenticacion ---
# Cambiar por un valor propio y secreto en cualquier entorno real.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
