server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Reenvia las llamadas a la API al servicio "backend" del docker-compose,
    # para que el navegador siempre le pegue a /api en el mismo origin desde
    # el que cargo la pagina. Evita hornear una URL absoluta (localhost:4000)
    # en el bundle, que solo funciona si quien abre la app esta en la misma
    # maquina donde corre el backend.

    # La direccion del backend y el DNS llegan por variables de entorno: en
    # Docker Compose, el nombre del servicio y el DNS interno de Docker; en
    # Render, la URL de la api de ESTE entorno (QA o PROD) y un DNS publico.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on;   # la api de Render es https: sin esto el TLS no sabe a que host va
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # index.html nunca se cachea: siempre hay que revalidar para no quedarse
    # con una version vieja que referencia assets con hash ya borrados tras
    # un redeploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Los archivos generados por Vite llevan hash en el nombre (ej.
    # index-zUdaoZKW.js), asi que un nombre nunca cambia de contenido: se
    # pueden cachear agresivo por un año.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Necesario para que las rutas de React Router (ej. /cliente, /admin)
    # no den 404 al refrescar la pagina: todo lo que no sea un archivo
    # existente cae en index.html y el router del lado del cliente resuelve.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
