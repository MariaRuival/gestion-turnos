# VITE_API_URL queda relativa (/api) por defecto: funciona sola en Docker
# (nginx la reenvia al backend, ver ../frontend/nginx.conf) y en "npm run dev"
# / "npm run preview" (vite.config.js trae su propio proxy /api -> backend).
#
# Copiar a ".env" solo si necesitas pisar algo:
# - VITE_API_URL: URL absoluta, si el backend se sirve desde otro origin.
# - VITE_BACKEND_URL: destino del proxy de Vite en dev/preview, si tu backend
#   local no corre en http://localhost:4000.
VITE_API_URL=/api
# VITE_BACKEND_URL=http://localhost:4000
