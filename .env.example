# Variables usadas por docker-compose.yml.
# Copiar este archivo a ".env" (en la raiz del repo) antes de correr "docker compose up".

POSTGRES_DB=gestion_turnos
POSTGRES_USER=turnos_user
POSTGRES_PASSWORD=turnos_pass

# Cambiar por un valor propio y secreto en cualquier entorno real.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# URL que usa el navegador para llamar a la API. Relativa por defecto: nginx
# (frontend/nginx.conf) reenvia /api/ al servicio "backend" del compose, asi
# que funciona sin importar desde que maquina se abra el frontend. Pisar solo
# si el backend se sirve desde otro origin/dominio.
VITE_API_URL=/api
